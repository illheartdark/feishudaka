# 构建产物（可用 build.ps1 重新生成）
build/
feishu-checkin/build/
*.apk
*.ap_
*.dex
*.class

# 规则 15：realise 下的 APK 允许入库（唯一允许存放 APK 的位置）
!realise/
!realise/*.apk

# 本地 SDK 路径
local.properties

# 签名密钥（不要入库）
*.keystore
*.jks

# IDE
.idea/
.vscode/
*.iml

# 临时文件
*.tmp
*.log
Thumbs.db
Desktop.ini
*.idsig
.tmp-*.js
